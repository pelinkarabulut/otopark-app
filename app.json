{
  "expo": {
    "name": "Otopark Formu",
    "slug": "otopark-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pelinkarabulut.otoparkapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Form fotoğrafı seçmek ve arşivlenen form görsellerini galerinize kaydetmek için fotoğraf kütüphanesine erişim gereklidir.",
        "NSPhotoLibraryAddUsageDescription": "Arşivlenen form görsellerini galerinize .jpeg olarak kaydedebilmek için izin gereklidir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "package": "com.pelinkarabulut.otoparkapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Otopark formu fotoğrafını galerinizden seçebilmek için fotoğraf erişimine ihtiyaç var."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Arşivlenen form fotoğraflarını galerinize kaydedebilmek için fotoğraf erişimine ihtiyaç var.",
          "savePhotosPermission": "Arşivlenen form fotoğraflarını galerinize .jpeg olarak kaydedebilmek için izin gerekiyor.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "98514e04-016b-4957-a483-0ce66ee36083"
      }
    }
  }
}
